{
  "name": "@mct/table-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoritative baccarat table runtime: draw table, seeded shoe, payouts, chip ledger and the betting-deal-settle state machine.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mct/shared": "workspace:*",
    "@mct/rule-packs": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  }
}
