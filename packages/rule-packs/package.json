{
  "name": "@mct/rule-packs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Versioned baccarat rule packs: Zod schema, validator, loader and sample packs.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mct/shared": "workspace:*",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  }
}
