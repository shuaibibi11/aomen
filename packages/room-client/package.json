{
  "name": "@mct/room-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Resilient browser WebSocket client for multiplayer rooms.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mct/room-protocol": "workspace:*",
    "@mct/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  }
}
