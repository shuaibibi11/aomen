{
  "name": "@mct/room-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebSocket message contracts between clients and the room server.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mct/rule-packs": "workspace:*",
    "@mct/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  }
}
