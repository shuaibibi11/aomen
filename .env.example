# Local, controlled development only. Copy this repository-root file to .env
# in the repository root; pnpm --filter @mct/server start loads that exact path.
# Never commit .env. Production must use a secret manager or systemd EnvironmentFile,
# whose process environment values take precedence over this local .env.
# Tokens and credentials stay server-only; never put them in frontend code or bundles.

# Shared loopback HTTP and WebSocket listener. Staging remote sessions require
# Nginx to terminate internal-CA TLS; do not expose this cleartext listener directly.
PORT=8787
# Only numeric loopback hosts are accepted; localhost is rejected.
BIND_HOST=127.0.0.1
# Leave ALLOWED_ORIGIN unset for controlled local loopback development.
# For staging remote sessions, use the exact Nginx TLS browser origin:
# https://<staging-ip>:8443 with wss://<staging-ip>:8443/ws.
# No-TLS direct IP access is unsupported for remote sessions.
# ALLOWED_ORIGIN=https://<staging-ip>:8443
WEBSOCKET_MAX_PAYLOAD_BYTES=65536
# WEBSOCKET_PER_MESSAGE_DEFLATE is intentionally unsupported and always false.

# Image generation relay (OpenAI-compatible)
MCT_IMAGE_API_BASE=https://your-relay-host
MCT_IMAGE_API_KEY=sk-your-key-here
MCT_IMAGE_MODEL=gpt-image-2

# Local HTTP proxy, if your network requires one to reach the relay.
# Leave empty to connect directly.
MCT_HTTP_PROXY=http://127.0.0.1:7897

# Demo room and server-only LLM decision configuration.
DEMO_ROOM_CREDENTIAL=replace-with-a-local-development-credential
AI_MODE=basic
# LLM_API_KEY is required only when AI_MODE=llm. This is a placeholder, not a key.
LLM_API_KEY=replace-with-a-server-only-secret
LLM_COMPLETIONS_URL=https://platform.rainflowtb.com/v1/chat/completions
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=4500

# LLM control plane foundation. This slice remains dormant by default and is
# not connected to AI_MODE=llm, live Rooms, or any provider adapter yet.
LLM_CONTROL_PLANE_MODE=disabled
# Exact DNS hostnames only; no URLs, IP literals, wildcards, or whitespace.
LLM_ENDPOINT_ALLOWED_HOSTS=platform.rainflowtb.com,api.openai.com,api.anthropic.com,generativelanguage.googleapis.com
# Required only for LLM_CONTROL_PLANE_MODE=postgres. Provide a base64url value
# encoding exactly 32 bytes through a production secret manager, never Git.
# LLM_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64url-32-byte-server-secret

# Persistence foundation. The current demo continues to use MemoryEventStore.
# Set PERSISTENCE_MODE=postgres only for a server deployment with a managed
# PostgreSQL database. DATABASE_URL is server-only: never commit a real value.
PERSISTENCE_MODE=memory
# DATABASE_URL=postgresql://training_user:replace-with-server-secret@db-host:5432/training
# Remote PostgreSQL always verifies the server certificate by default.
# DATABASE_TLS_MODE=verify-full
# Only an explicit loopback or Unix-socket local development database may disable TLS.
# DATABASE_URL=postgresql://training_user:replace-with-local-secret@127.0.0.1:5432/training
# DATABASE_TLS_MODE=disable
# Do not add ssl, sslmode, or any other ssl* query option to DATABASE_URL.
